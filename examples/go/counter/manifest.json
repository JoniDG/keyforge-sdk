{
  "manifest_version": 1,
  "id": "dev.jonidg.counter",
  "name": "Counter",
  "version": "0.1.0",
  "protocol_version": "1",
  "author": "Jonathan Daniel Gomez",
  "description": "Example plugin from the plugin author tutorial: a counter for streams that can write its value to a text file.",
  "homepage": "https://github.com/JoniDG/keyforge-sdk/tree/main/examples/go/counter",
  "category": "Examples",
  "entrypoint": {
    "darwin": { "path": "bin/counter-darwin" },
    "linux": { "path": "bin/counter-linux" },
    "windows": { "path": "bin/counter.exe" }
  },
  "actions": [
    {
      "id": "count",
      "name": "Count",
      "description": "A key adds one. On an encoder, turn right to add, left to subtract, press to reset.",
      "inputs": ["key", "encoder"],
      "params": [
        { "name": "label", "label": "Label", "type": "string", "required": false, "placeholder": "Deaths" },
        { "name": "file", "label": "Write to file", "type": "string", "required": false, "placeholder": "/Users/me/obs/deaths.txt" }
      ]
    }
  ]
}
